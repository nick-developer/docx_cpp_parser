"""Type stubs for the compiled extension ``docx_comment_parser._core``.

pybind11 emits no inline type information, so the shape of the C++ API is
declared here for mypy and for editor completion.

Note: the ``to_*`` / ``export_*`` methods on :class:`DocxParser` and
:class:`BatchParser` are *not* implemented in C++.  They are attached to these
classes at import time by ``docx_comment_parser/__init__.py``.  They are
declared here because that is where the type checker looks them up.
"""

from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Union

import pandas
import polars

from .llm.dataset import LLMDataset
from .models import Comment

PathLike = Union[str, Path]

class CommentRef:
    id: int
    author: str
    date: str
    text_snippet: str

class CommentMetadata:
    id: int
    author: str
    date: str
    initials: str
    text: str
    paragraph_style: str
    range_start_para_id: str
    range_end_para_id: str
    referenced_text: str
    is_reply: bool
    parent_id: int
    replies: List[CommentRef]
    para_id: str
    para_id_parent: str
    done: bool
    paragraph_index: int
    run_index: int
    thread_ids: List[int]
    def to_dict(self) -> Dict[str, Any]: ...

class DocumentCommentStats:
    file_path: str
    total_comments: int
    total_resolved: int
    total_replies: int
    total_root_comments: int
    unique_authors: List[str]
    earliest_date: str
    latest_date: str
    def to_dict(self) -> Dict[str, Any]: ...

class DocxParserError(RuntimeError): ...
class DocxFileError(DocxParserError, IOError): ...
class DocxFormatError(DocxParserError, ValueError): ...

class DocxParser:
    def __init__(self) -> None: ...
    def parse(self, file_path: str) -> None: ...
    def comments(self) -> List[CommentMetadata]: ...
    def stats(self) -> DocumentCommentStats: ...
    def find_by_id(self, id: int) -> Optional[CommentMetadata]: ...
    def by_author(self, author: str) -> List[CommentMetadata]: ...
    def root_comments(self) -> List[CommentMetadata]: ...
    def thread(self, root_id: int) -> List[CommentMetadata]: ...
    # --- attached by docx_comment_parser/__init__.py ---
    def to_comments(self) -> List[Comment]: ...
    def to_dataframe(self) -> pandas.DataFrame: ...
    def to_polars(self) -> polars.DataFrame: ...
    def to_dict(self) -> List[Dict[str, Any]]: ...
    def to_json(self, indent: int = ...) -> str: ...
    def export_json(self, path: PathLike, indent: int = ...) -> Path: ...
    def export_csv(
        self, path: PathLike, encoding: str = ..., delimiter: str = ...
    ) -> Path: ...
    def to_llm_dataset(
        self,
        chars_before: int = ...,
        chars_after: int = ...,
        **kwargs: Any,
    ) -> List[Dict[str, Any]]: ...
    def to_llm_records(
        self,
        chars_before: int = ...,
        chars_after: int = ...,
        include_thread: bool = ...,
        include_context: bool = ...,
        classify: bool = ...,
        anonymize: Optional[Any] = ...,
        anonymizer: Optional[Any] = ...,
    ) -> LLMDataset: ...
    def to_llm_chunks(self, max_tokens: int = ..., **kwargs: Any) -> List[Any]: ...
    def to_jsonl(self, **kwargs: Any) -> str: ...
    def export_jsonl(self, path: PathLike, **kwargs: Any) -> Path: ...
    def to_embeddings_input(
        self, granularity: str = ..., **kwargs: Any
    ) -> List[Dict[str, Any]]: ...
    def anonymize(self, policy: Any = ..., **kwargs: Any) -> Any: ...
    def privacy_scan(self) -> Any: ...

class BatchParser:
